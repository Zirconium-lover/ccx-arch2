# Reproducible PARDISO/MKL build of CalculiX 2.23 + damage/fracture module
# Target platform: Ubuntu 24.04 LTS (x86_64).
#
# The historical s3rad wall was measured with PARDISO.  Comparing a SPOOLES
# run against that baseline changes two things at once, so this makefile
# exists to keep the solver constant while the continuation method changes.
#
# Dependencies (apt):
#   gfortran libblas-dev liblapack-dev libarpack2-dev libspooles-dev make gcc
#   intel-mkl            (universe/multiverse, 2020.4.304-4)
#
# Linear solvers: PARDISO (isolver=7, *SOLVER=PARDISO) AND SPOOLES
# (isolver=0), so one binary can run both and the difference is an
# explicit deck/environment choice rather than a different executable.
#
# Build OUT OF TREE so that the SPOOLES-only objects are never mixed with
# the -DPARDISO ones:
#
#   ./src/build_mkl.sh            # -> build-mkl/ccx_2.23_pardiso
#
# MKL_INTERFACE:
#   MKL is LP64 here (32-bit integers), which matches CalculiX built
#   without -DLONGLONG.  libmkl_gf_lp64 is the gfortran-compatible
#   interface layer; libmkl_intel_lp64 assumes ifort conventions.

CCXVERSION = 2.23
EXE        = ccx_$(CCXVERSION)_pardiso

OPTLEVEL  ?= -O2
EXTRA_CFLAGS ?=
EXTRA_FFLAGS ?=
EXTRA_LDFLAGS ?=

SPOOLES_INC = /usr/include/spooles
MKL_INC     = /usr/include/mkl
MKL_LIBDIR  = /usr/lib/x86_64-linux-gnu

# -MMD -MP makes gcc emit a .d file per object listing the headers it read,
# and the -include at the bottom feeds those back to make.  Without it a
# change to CalculiX.h or ccxopt_decl.h rebuilds NOTHING, and the build
# quietly links a stale object.  That is not a tidiness issue here: it can
# invalidate a bit-identity claim, because the binary under test is then not
# the binary the sources describe.  Measured the hard way - a declaration
# table edited three times and compiled none of them.
# -Werror on TWO warning classes, and only two.  C lets an integer be
# passed where a pointer is expected with nothing but a warning, and in a
# tree whose calls take a hundred and thirty arguments that is not a style
# question: it is a segfault three hundred lines later.  It happened -
# a refactor left `dogleg_configure(&dog,&rsc,lc.reg_nlam)' where the third
# parameter is a `const loadctl *', the build printed a warning nobody
# grepped for, and eleven of sixteen gate cases died with SIGSEGV inside
# the arming block.  With these flags that same line does not compile;
# OBSERVED, by putting it back.
#
# They cost nothing: the whole tree, stock CalculiX included, builds clean
# with them.  -Werror=implicit-function-declaration is deliberately NOT
# here - the Fortran entry points are called without prototypes all over
# the stock sources and that is a different argument.
CFLAGS = -Wall -Werror=int-conversion -Werror=incompatible-pointer-types $(OPTLEVEL) -DARCH="Linux" -DSPOOLES -DARPACK -DPARDISO \
         -DMATRIXSTORAGE -DNETWORKOUT -MMD -MP -fopenmp -I$(SPOOLES_INC) \
         -I$(MKL_INC) $(EXTRA_CFLAGS)
FFLAGS = -Wall $(OPTLEVEL) -fopenmp -fallow-argument-mismatch -cpp $(EXTRA_FFLAGS)

CC = gcc
FC = gfortran

# MKL supplies BLAS and LAPACK as well; reference blas/lapack must NOT be
# on the link line as well or the two implementations fight over symbols.
LIBS = -lspooles -larpack \
       -Wl,--start-group \
         $(MKL_LIBDIR)/libmkl_gf_lp64.a \
         $(MKL_LIBDIR)/libmkl_gnu_thread.a \
         $(MKL_LIBDIR)/libmkl_core.a \
       -Wl,--end-group \
       -fopenmp -lpthread -lm -ldl

.c.o:
	$(CC) $(CFLAGS) -c $< -o $@
.f.o:
	$(FC) $(FFLAGS) -c $< -o $@

include Makefile.inc

SCCXMAIN = ccx_$(CCXVERSION).c
OCCXF = $(SCCXF:.f=.o)
OCCXC = $(SCCXC:.c=.o)

SELFTEST = ccx_selftest

all: $(EXE) $(SELFTEST)

ccx_$(CCXVERSION).a: $(OCCXF) $(OCCXC)
	ar rs $@ $?

$(EXE): ccx_$(CCXVERSION).a ccx_$(CCXVERSION).c
	$(CC) $(CFLAGS) -c ccx_$(CCXVERSION).c -o ccx_$(CCXVERSION).o
	$(FC) $(FFLAGS) $(EXTRA_LDFLAGS) -o $@ ccx_$(CCXVERSION).o \
	      ccx_$(CCXVERSION).a $(LIBS)

# The self test runner links against the SAME archive the solver does, so
# what it exercises is what ships - not a copy and not a subset built with
# different flags.  It costs one extra object and one extra link, and it
# buys a second-long answer to a question that used to cost a finite
# element analysis.
$(SELFTEST): ccx_$(CCXVERSION).a selftest_main.c
	$(CC) $(CFLAGS) -c selftest_main.c -o selftest_main.o
	$(FC) $(FFLAGS) $(EXTRA_LDFLAGS) -o $@ selftest_main.o \
	      ccx_$(CCXVERSION).a $(LIBS)

clean:
	rm -f *.o *.d *.mod *.a $(EXE) $(SELFTEST)

.PHONY: all clean

-include $(OCCXC:.o=.d) ccx_$(CCXVERSION).d selftest_main.d
